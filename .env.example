# Kira — Docker Compose environment
# Copy to .env and replace the placeholders. Never commit .env.
#   cp .env.example .env

# Database (MongoDB starts with auth enabled)
DB_USERNAME=kira
DB_PASSWORD=change-me
DB_NAME=kira

# Backend
BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth — required to sign in on the dashboard
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini — required for text enhancement
GEMINI_API_KEY=

# Stripe — leave empty to run without billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Chrome extension ID from chrome://extensions (CORS allow-list)
EXTENSION_ID=
