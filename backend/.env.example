# Backend Environment Variables

# MongoDB (local dev without auth)
MONGODB_URI=mongodb://localhost:27017/content-enhancer

# MongoDB (production with auth via docker-compose)
# MONGODB_URI=mongodb://${DB_USERNAME}:${DB_PASSWORD}@database:27017/${DB_NAME}

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-change-me
BETTER_AUTH_URL=http://localhost:3001

# Gemini — required for /api/enhance
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Chrome Extension
EXTENSION_ID=igmencoidcodhdiccnokpijdiepghlmb

